{
  "name": "capstage",
  "version": "1.0.0",
  "private": true,
  "description": "CapStage - plateforme de creation de CV et de suivi de recherche de stage/alternance pour etablissements de formation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "db:init": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "db:reset": "node server/src/db/reset.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/src/index.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
