# Copier ce fichier en .env puis adapter les valeurs.

# development | production
NODE_ENV=development

# Port d'ecoute de l'API (et de l'application en production)
PORT=3001

# Repertoire des donnees (base SQLite + photos), relatif a la racine du projet
DATA_DIR=data
DB_FILE=capstage.sqlite

# OBLIGATOIRE en production : chaine aleatoire d'au moins 32 caracteres
# Generation : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-en-production

# Duree de validite d'une session (heures)
SESSION_HOURS=12

# Taille maximale d'une photo de CV (octets)
MAX_PHOTO_BYTES=1500000

# Nom affiche dans l'interface
PLATFORM_NAME=CapStage
